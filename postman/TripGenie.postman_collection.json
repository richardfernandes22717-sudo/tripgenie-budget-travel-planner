{
  "info": {
    "name": "TripGenie API",
    "description": "Portable API checks for TripGenie",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "tripId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j=pm.response.json(); if(j.success) pm.collectionVariables.set('token',j.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"user@tripgenie.local\", \"password\": \"User@123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j=pm.response.json(); if(j.success) pm.collectionVariables.set('adminToken',j.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@tripgenie.local\", \"password\": \"Admin@123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Destinations",
      "item": [
        {
          "name": "List destinations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/destinations?limit=12",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "destinations"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "12"
                }
              ]
            }
          }
        },
        {
          "name": "Destination detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/destinations/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "destinations",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "Generate itinerary",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": \"Bengaluru\",\n  \"destinationId\": 1,\n  \"totalBudget\": 25000,\n  \"travellers\": 2,\n  \"days\": 3,\n  \"startDate\": \"2026-08-10\",\n  \"endDate\": \"2026-08-12\",\n  \"interests\": \"Beach,Culture\",\n  \"cuisines\": \"Indian,Local\",\n  \"dietaryRequirements\": \"Vegetarian\",\n  \"contingencyPercent\": 5,\n  \"miscellaneous\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/generate-itinerary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai",
                "generate-itinerary"
              ]
            }
          }
        },
        {
          "name": "Chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"message\": \"Compare Goa and Jaipur for a budget trip\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai",
                "chat"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Trips",
      "item": [
        {
          "name": "List saved trips",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/trips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trips"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "stats"
              ]
            }
          }
        },
        {
          "name": "List hotels",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/hotels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "hotels"
              ]
            }
          }
        }
      ]
    }
  ]
}